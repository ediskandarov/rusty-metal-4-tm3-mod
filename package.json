{
  "name": "rusty-metal-4-tm3-mod",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "external/rusty-metal-4/packages/resources",
    "external/rusty-metal-4/packages/dev-server-client",
    "external/rusty-metal-4/packages/mr-preparation",
    "external/rusty-metal-4/packages/mods"
  ],
  "scripts": {
    "build:shared": "bun apps/build-shared/src/main.ts",
    "check": "bun run lint && bun run typecheck && bun run fmt:check",
    "lint": "bun lint --no-script --max-warnings=0 apps packages tests",
    "typecheck": "bun check --no-script -p tsconfig.json",
    "fmt": "bun fmt --no-script apps packages package.json tsconfig.json bunfig.toml tests",
    "fmt:check": "bun fmt --no-script --check apps packages package.json tsconfig.json bunfig.toml tests",
    "test": "bun test ./packages/ ./tests/",
    "build:cars": "bun apps/build-cars/src/main.ts",
    "build:maps": "bun apps/build-maps/src/main.ts",
    "test:execution": "bun tests/browser/execution.mjs",
    "test:maps": "bun tests/browser/maps.mjs"
  },
  "devDependencies": {
    "@tm4/mods": "workspace:*",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4"
  }
}
