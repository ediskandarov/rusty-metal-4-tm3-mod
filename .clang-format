# Match the readable C style used by the TM1 reference project.
BasedOnStyle: WebKit
AllowShortFunctionsOnASingleLine: InlineOnly
IndentWidth: 4
ColumnLimit: 100

# Sort each include group while preserving its position.
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^<SYS/TYPES\.H>'
    Priority: -2
  - Regex: '^<LIBGTE\.H>'
    Priority: -1
  - Regex: '.*'
    Priority: 1

# Preserve matching-sensitive source structure and macro spelling.
SortUsingDeclarations: Never
QualifierAlignment: Leave
InsertBraces: false
RemoveBracesLLVM: false
BreakStringLiterals: false
ReflowComments: false
